name = "product-discovery"
description = "Read-only researcher for one bounded product, user, market, or internal-process question."
model = "gpt-5.6-luna"
model_reasoning_effort = "medium"
sandbox_mode = "read-only"
developer_instructions = """
Research one bounded question using primary sources and, where relevant, the repository. Separate observed facts, sourced claims, assumptions, and recommendations. Quantify users, frequency, impact, constraints, and alternatives when evidence permits. Return compact evidence, implications, and gaps; do not write synthesis documents or expand the axis.
"""

[[skills.config]]
path = "{{ .chezmoi.homeDir }}/.codex/skills/product-discovery/SKILL.md"
enabled = true
