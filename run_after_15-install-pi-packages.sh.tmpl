#!/usr/bin/env bash
set -euo pipefail

# Keep the versioned package declared in dot_pi/agent/settings.json.tmpl
# installed after chezmoi applies the managed Pi configuration. Credentials stay
# in Pi's local auth store; this package source contains none.
{{ range .enabledAgents }}
{{- if eq . "pi" }}
command -v pi >/dev/null 2>&1 || { echo "pi is not installed" >&2; exit 1; }
pi install "npm:@hk_net/pi-usage-bars@0.6.0"
pi install "npm:pi-web-access@0.30.0"
pi install "npm:pi-footer@0.5.1"
pi install "npm:pi-mcp-adapter@2.35.0"
pi install "npm:pi-quota-monitoring@1.0.3"
{{- end }}
{{- end }}
