{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

if command -v gsettings >/dev/null 2>&1; then
  current_desktop="${XDG_CURRENT_DESKTOP:-}"

{{ range .tweaks.linux.gsettings -}}
{{- if .desktop }}
  case "$current_desktop" in
    *{{ .desktop }}*)
      gsettings set {{ .schema }} {{ .key }} {{ .value | quote }}
      ;;
  esac
{{ else -}}
  gsettings set {{ .schema }} {{ .key }} {{ .value | quote }}
{{ end -}}
{{ end }}
fi

{{ range .tweaks.linux.commands -}}
if ! {{ .check }} >/dev/null 2>&1; then
  echo "Aplicando tweak {{ .name }}..."
{{ .run | indent 2 }}
fi
{{ end -}}
{{ else if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -e

{{ range .tweaks.darwin.defaults -}}
defaults write {{ .domain }} {{ .key }} {{ .type }} {{ .value | quote }}
{{ end -}}

{{ range .tweaks.darwin.commands -}}
if ! {{ .check }} >/dev/null 2>&1; then
  echo "Aplicando tweak {{ .name }}..."
{{ .run | indent 2 }}
fi
{{ end -}}
{{ end -}}
