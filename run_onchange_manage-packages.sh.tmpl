{{ if eq .chezmoi.os "linux" -}}
#!/bin/sh
set -e

{{ range .packages.linux.dnf_remove -}}
if rpm -q {{ . }} > /dev/null 2>&1; then
  echo "Removendo {{ . }}..."
  sudo dnf remove -y {{ . }}
fi
{{ end -}}

{{ range .packages.linux.dnf_install -}}
if ! rpm -q {{ . }} > /dev/null 2>&1; then
  echo "Instalando {{ . }}..."
  sudo dnf install -y {{ . }}
fi
{{ end -}}
{{ range .packages.linux.custom -}}
if ! {{ .check }} > /dev/null 2>&1; then
  echo "Instalando {{ .name }}..."
  {{ .install }}
fi
{{ end -}}

{{ else if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -e

{{ range .packages.darwin.brew -}}
if ! brew list {{ . }} > /dev/null 2>&1; then
  echo "Instalando {{ . }}..."
  brew install {{ . }}
fi
{{ end -}}

{{ end -}}
