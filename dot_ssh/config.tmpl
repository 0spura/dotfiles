# SSH client for homelab hostnames. Deployed on every machine: *.blima.dev
# always resolves at the Cloudflare edge, so no IP is ever hardcoded.
# Auth is a short-lived cert per Access login (no static key):
#   cloudflared access login https://ssh.blima.dev
# then `ssh` below works from any network, with no WARP required.
# The Match+exec line regenerates the cert on each connection; the
# ProxyCommand carries it through the tunnel.
Match host ssh.blima.dev exec "{{ .cloudflaredBin }} access ssh-gen --hostname %h"
  HostName ssh.blima.dev
  ProxyCommand {{ .cloudflaredBin }} access ssh --hostname %h
  IdentityFile ~/.cloudflared/%h-cf_key
  CertificateFile ~/.cloudflared/%h-cf_key-cert.pub

# Alias estavel para o Mac: o Zed usa o ssh local, entao herda ProxyCommand
# + cert automaticamente (Remote Projects -> Connect New Server ->
# `ssh luisf@mac-mini ...`). ControlMaster acelera reconexoes do Zed.
Host mac-mini
  HostName ssh.blima.dev
  User luisf
  ProxyCommand {{ .cloudflaredBin }} access ssh --hostname %h
  IdentityFile ~/.cloudflared/ssh.blima.dev-cf_key
  CertificateFile ~/.cloudflared/ssh.blima.dev-cf_key-cert.pub
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 10m
