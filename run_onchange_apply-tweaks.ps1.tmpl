{{ if eq .chezmoi.os "windows" -}}
$ErrorActionPreference = "Stop"

{{ range .tweaks.windows.registry -}}
$registryPath = "{{ .hive }}:\{{ .path }}"
if (-not (Test-Path $registryPath)) {
  New-Item -Path $registryPath -Force | Out-Null
}

$currentValue = (Get-ItemProperty -Path $registryPath -Name "{{ .name }}" -ErrorAction SilentlyContinue)."{{ .name }}"
if ($currentValue -ne {{ .value | quote }}) {
  Write-Host "Aplicando tweak registry {{ .name }}..."
  New-ItemProperty -Path $registryPath -Name "{{ .name }}" -PropertyType {{ .type }} -Value {{ .value | quote }} -Force | Out-Null
}

{{ end -}}
{{ range .tweaks.windows.powershell -}}
$checkResult = & {
{{ .check | indent 2 }}
}
if (-not $checkResult) {
  Write-Host "Aplicando tweak {{ .name }}..."
{{ .run | indent 2 }}
}

{{ end -}}
{{ range .tweaks.windows.commands -}}
if (-not ({{ .check }})) {
  Write-Host "Aplicando tweak {{ .name }}..."
{{ .run | indent 2 }}
}

{{ end -}}
{{ end -}}
