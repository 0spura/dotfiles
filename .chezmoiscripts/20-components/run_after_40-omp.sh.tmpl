{{ if and (ne .chezmoi.os "windows") (has "omp" .enabledAgents) -}}
#!/bin/sh
# Install or upgrade OMP to the latest release whenever it is selected for
# this machine. Authentication remains in OMP's local agent.db, never in
# dotfiles.
set -eu

# Resolve the newest tag from the upstream repo and install it. The installer
# runs at the same ref it was fetched from, so the fetched revision is the
# one that runs.
latest=$(curl -fsSL -o /dev/null -w '%{url_effective}' https://github.com/can1357/oh-my-pi/releases/latest | sed 's|.*/tag/||')
if [ -z "$latest" ]; then
  echo "omp: could not resolve latest release; keeping installed version" >&2
  exit 0
fi
ver=$(omp --version 2>/dev/null | sed -n 's|^omp[/ ]v\?||p')
if [ "v${ver}" != "${latest}" ]; then
  tmp=$(mktemp -d)
  curl -fsSL "https://raw.githubusercontent.com/can1357/oh-my-pi/${latest}/scripts/install.sh" -o "$tmp/install.sh"
  sh "$tmp/install.sh" --ref "${latest}" --binary
  rm -rf "$tmp"
else
  echo "omp: already at latest (${latest})"
fi
{{- end }}

