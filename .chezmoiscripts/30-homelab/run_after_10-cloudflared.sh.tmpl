{{ if ne .chezmoi.os "windows" -}}
#!/bin/sh
# cloudflared on every machine (installs only when missing). The homelab server
# runs the tunnel daemon for its HTTP services (see run_after_20-tunnel-register).
set -eu

is_macos() { [ "$(uname -s)" = "Darwin" ]; }

if ! command -v cloudflared >/dev/null 2>&1; then
  if is_macos; then
    PATH="/opt/homebrew/bin:/usr/local/bin:$PATH" export PATH
    brew install cloudflare/cloudflare/cloudflared
  elif command -v dnf >/dev/null 2>&1; then
    sudo dnf install -y cloudflared
  else
    echo "homelab: no cloudflared installer for this OS; the tunnel needs it manually" >&2
  fi
fi
{{ end -}}
