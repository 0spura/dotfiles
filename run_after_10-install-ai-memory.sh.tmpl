{{ if ne .chezmoi.os "windows" -}}
#!/bin/sh
# Installs ai-memory: CLI wrapper, and, when aiMemoryRunServer is true, the
# server container (docker) and its LLM/embedding provider. Then installs
# lifecycle hooks for every agent in enabledAgents. Runs on every chezmoi
# apply so hook scripts (~/.local/share/ai-memory/hooks/<agent>/) get
# refreshed whenever the ai-memory CLI is upgraded; every step is guarded
# so re-running is cheap. On Windows use WSL2 instead.
set -eu

export PATH="$HOME/.local/bin:$PATH"

# 1. CLI wrapper (official quickstart, with checksum verification)
if ! command -v ai-memory >/dev/null 2>&1; then
  mkdir -p "$HOME/.local/bin"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  base="https://github.com/akitaonrails/ai-memory/releases/latest/download/ai-memory-wrapper"
  curl -fsSL "$base" -o "$tmp/ai-memory-wrapper"
  curl -fsSL "$base.sha256" -o "$tmp/ai-memory-wrapper.sha256"
  expected="$(awk 'NR == 1 { print $1 }' "$tmp/ai-memory-wrapper.sha256")"
  if command -v sha256sum >/dev/null 2>&1; then
    actual="$(sha256sum "$tmp/ai-memory-wrapper" | awk '{ print $1 }')"
  else
    actual="$(shasum -a 256 "$tmp/ai-memory-wrapper" | awk '{ print $1 }')"
  fi
  if [ -z "$expected" ] || [ "$actual" != "$expected" ]; then
    echo "ai-memory wrapper checksum mismatch" >&2
    exit 1
  fi
  install -m 0755 "$tmp/ai-memory-wrapper" "$HOME/.local/bin/ai-memory"
fi

{{- if .aiMemoryRunServer }}

# 2. Dependency check: openai-compat providers point the container at an
# Ollama on this host. Ollama itself is a separate module
# (run_once_before_05-install-ollama.sh, ollamaEnabled in the chezmoi config).
{{- if or (eq .aiMemoryLlmProvider "openai-compat") (eq .aiMemoryEmbeddingProvider "openai-compat") }}
if ! command -v ollama >/dev/null 2>&1; then
  echo "an ai-memory provider is 'openai-compat' but ollama is not installed;" >&2
  echo "set ollamaEnabled=true in ~/.config/chezmoi/chezmoi.toml and re-apply" >&2
  exit 1
fi
{{- end }}

# 3. Server container (docker). Bind is loopback-only unless
# aiMemoryShareOnNetwork is true, in which case it listens on the network
# and requires AI_MEMORY_AUTH_TOKEN.
url="{{ .aiMemoryUrl }}"
hostport="${url#http://}"
hostport="${hostport#https://}"
hostport="${hostport%%/*}"
port="${hostport##*:}"
bind_host="127.0.0.1"
{{- if .aiMemoryShareOnNetwork }}
bind_host="0.0.0.0"
{{- end }}

if command -v docker >/dev/null 2>&1; then
  if [ -z "$(docker ps -q --filter "name=^/ai-memory$")" ]; then
    if [ -n "$(docker ps -aq --filter "name=^/ai-memory$")" ]; then
      docker start ai-memory >/dev/null
    else
      docker run -d --name ai-memory \
        --restart unless-stopped \
{{- if or (eq .aiMemoryLlmProvider "openai-compat") (eq .aiMemoryEmbeddingProvider "openai-compat") }}
        --add-host=host.docker.internal:host-gateway \
{{- end }}
        -p "${bind_host}:${port}:49374" \
        -v ai-memory-data:/data \
{{- if .aiMemoryShareOnNetwork }}
        -e AI_MEMORY_AUTH_TOKEN={{ .aiMemoryAuthToken }} \
{{- end }}
{{- if or (ne .aiMemoryLlmProvider "none") (ne .aiMemoryEmbeddingProvider "none") }}
        -e AI_MEMORY_CONSOLIDATE_ON_SESSION_END=true \
{{- end }}
{{- if eq .aiMemoryLlmProvider "anthropic" }}
        -e AI_MEMORY_LLM_PROVIDER=anthropic \
        -e ANTHROPIC_API_KEY={{ .anthropicApiKey }} \
        -e AI_MEMORY_LLM_MODEL={{ .aiMemoryLlmModel }} \
{{- else if eq .aiMemoryLlmProvider "anthropic-oauth" }}
        -e AI_MEMORY_LLM_PROVIDER=anthropic-oauth \
{{- else if eq .aiMemoryLlmProvider "openai" }}
        -e AI_MEMORY_LLM_PROVIDER=openai \
        -e OPENAI_API_KEY={{ .openaiApiKey }} \
        -e AI_MEMORY_LLM_MODEL={{ .aiMemoryLlmModel }} \
{{- else if eq .aiMemoryLlmProvider "openai-oauth" }}
        -e AI_MEMORY_LLM_PROVIDER=openai-oauth \
{{- else if eq .aiMemoryLlmProvider "copilot" }}
        -e AI_MEMORY_LLM_PROVIDER=copilot \
{{- else if eq .aiMemoryLlmProvider "gemini" }}
        -e AI_MEMORY_LLM_PROVIDER=gemini \
        -e GEMINI_API_KEY={{ .geminiApiKey }} \
        -e AI_MEMORY_LLM_MODEL={{ .aiMemoryLlmModel }} \
{{- else if eq .aiMemoryLlmProvider "openai-compat" }}
        -e AI_MEMORY_LLM_PROVIDER=openai-compat \
        -e AI_MEMORY_LLM_BASE_URL={{ .aiMemoryBaseUrl }} \
        -e AI_MEMORY_LLM_MODEL={{ .aiMemoryLlmModel }} \
{{- end }}
{{- if eq .aiMemoryEmbeddingProvider "openai" }}
        -e AI_MEMORY_EMBEDDING_PROVIDER=openai \
        -e OPENAI_API_KEY={{ .openaiApiKey }} \
        -e AI_MEMORY_EMBEDDING_MODEL={{ .aiMemoryEmbedModel }} \
{{- else if eq .aiMemoryEmbeddingProvider "voyage" }}
        -e AI_MEMORY_EMBEDDING_PROVIDER=voyage \
        -e VOYAGE_API_KEY={{ .voyageApiKey }} \
        -e AI_MEMORY_EMBEDDING_MODEL={{ .aiMemoryEmbedModel }} \
{{- else if eq .aiMemoryEmbeddingProvider "google" }}
        -e AI_MEMORY_EMBEDDING_PROVIDER=google \
        -e GOOGLE_API_KEY={{ .geminiApiKey }} \
        -e AI_MEMORY_EMBEDDING_MODEL={{ .aiMemoryEmbedModel }} \
{{- else if eq .aiMemoryEmbeddingProvider "gemini" }}
        -e AI_MEMORY_EMBEDDING_PROVIDER=gemini \
        -e GEMINI_API_KEY={{ .geminiApiKey }} \
        -e AI_MEMORY_EMBEDDING_MODEL={{ .aiMemoryEmbedModel }} \
{{- else if eq .aiMemoryEmbeddingProvider "openai-compat" }}
        -e AI_MEMORY_EMBEDDING_PROVIDER=openai-compat \
        -e AI_MEMORY_EMBEDDING_BASE_URL={{ .aiMemoryEmbedBaseUrl }} \
        -e AI_MEMORY_EMBEDDING_MODEL={{ .aiMemoryEmbedModel }} \
        -e AI_MEMORY_EMBEDDING_DIM={{ .aiMemoryEmbedDim }} \
{{- end }}
        akitaonrails/ai-memory:latest >/dev/null
    fi
  fi
else
  echo "docker not found; ai-memory server not started" >&2
  exit 1
fi

{{- if or (eq .aiMemoryLlmProvider "anthropic-oauth") (eq .aiMemoryLlmProvider "openai-oauth") (eq .aiMemoryLlmProvider "copilot") }}
echo "ai-memory: run 'ai-memory auth login {{ .aiMemoryLlmProvider }}' to finish LLM provider setup" >&2
{{- end }}
{{- end }}

# 4. Hook scripts for the agents selected in enabledAgents. chezmoi owns every
# agent configuration file, so install-hooks receives a disposable config path:
# it stages fresh hook scripts under ~/.local/share/ai-memory/hooks/<agent>/
# without rewriting the managed config or hooks file.
#
# kiro-cli is not natively supported by ai-memory install-hooks, so its
# hook scripts are managed by chezmoi directly (see run_after_20-seed-ai-memory-rules.sh).
{{ range .enabledAgents }}
{{- if ne . "kiro-cli" }}
hook_config_dir="$(mktemp -d)"
ai-memory install-hooks --agent "{{ . }}" --apply --config-file "$hook_config_dir/config"
rm -rf "$hook_config_dir"
{{- end }}
{{ end -}}

# kiro-cli: not supported by install-hooks, stage manually from chezmoi source.
{{ if has "kiro-cli" .enabledAgents -}}
kiro_hooks="$HOME/.local/share/ai-memory/hooks/kiro-cli"
mkdir -p "$kiro_hooks"
# Copy _lib.sh from a supported agent's staged hooks (always fresh after
# install-hooks above) so the kiro-cli hooks get the same version.
for peer_dir in claude-code kimi-code codex cursor gemini-cli; do
  peer="$HOME/.local/share/ai-memory/hooks/$peer_dir/_lib.sh"
  if [ -f "$peer" ]; then
    cp "$peer" "$kiro_hooks/_lib.sh"
    break
  fi
done
# Copy kiro-cli hook scripts from the chezmoi source directory.
chezmoi_src="{{ .chezmoi.sourceDir }}/ai-memory/hooks/kiro-cli"
if [ -d "$chezmoi_src" ]; then
  for f in "$chezmoi_src"/*.sh; do
    [ -f "$f" ] || continue
    fname=$(basename "$f")
    [ "$fname" = "_lib.sh" ] && continue
    install -m 0755 "$f" "$kiro_hooks/$fname"
  done
fi
{{ end -}}
{{ end -}}
