{{ if ne .chezmoi.os "windows" -}}
#!/bin/sh
# Install the reviewed, pinned OMP release only when OMP is selected for this
# machine. Authentication remains in OMP's local agent.db, never in dotfiles.
set -eu

{{ range .enabledAgents }}
{{- if eq . "omp" }}
# `omp --version` prints "omp/<version>". Install only when omp is missing or
# older than the reviewed pin, so a newer local build is never downgraded.
# The installer is fetched at the same tag as the ref, so the reviewed
# revision is the one that runs.
pin=18.2.8
ver=$(omp --version 2>/dev/null | sed -n 's|^omp[/ ]v\?||p')
older_than() { # true when dotted version $1 is older than $2 (POSIX awk)
  awk -v a="$1" -v b="$2" 'BEGIN {
    n = split(a, x, "."); m = split(b, y, ".")
    for (i = 1; i <= (n > m ? n : m); i++) {
      if (x[i] + 0 < y[i] + 0) exit 0
      if (x[i] + 0 > y[i] + 0) exit 1
    }
    exit 1
  }'
}
if ! command -v omp >/dev/null 2>&1 || { [ -n "$ver" ] && older_than "$ver" "$pin"; }; then
  tmp=$(mktemp -d)
  curl -fsSL "https://raw.githubusercontent.com/can1357/oh-my-pi/v${pin}/scripts/install.sh" -o "$tmp/install.sh"
  sh "$tmp/install.sh" --ref "v${pin}"
  rm -rf "$tmp"
else
  echo "omp: keeping installed version (${ver:-unknown}); pin ${pin}"
fi
{{- end }}
{{- end }}
{{- end }}
