<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Remapeia Ctrl externo para Command (teclado ABNT no Mac).
     Gerenciado pelo chezmoi; o hidutil reseta a cada reboot, por isso
     o agente reaplica no login (RunAtLoad). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.luis.keyboard-remap</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/hidutil</string>
        <string>property</string>
        <string>--set</string>
        <string>{"UserKeyMapping":[{"HIDKeyboardModifierMappingSrc":30064771296,"HIDKeyboardModifierMappingDst":30064771299}]}</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
